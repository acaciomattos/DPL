    ],
    "grouped_category_candidate_limit": 6,
    "pair_rule_feature_limit": 4,
    "pair_rule_candidate_limit": 6,
    "signal_bundle_feature_limit": 6,
    "signal_bundle_candidate_limit": 6,
    "layered_rule_numeric_limit": 4,
    "layered_rule_signal_limit": 4,
    "layered_rule_candidate_limit": 6,
    "new_rule_numeric_operators": [
      ">",
      "<"
    ],
    "top_k": 8,
    "seed": 17,
    "annealing_iterations": 10,
    "annealing_initial_temperature": 1.25,
    "annealing_cooling_rate": 0.85,
    "annealing_seed_limit": 18,
    "annealing_neighbor_limit": 12,
    "risk_comfort_threshold": 0.05,
    "objective_weights": {
